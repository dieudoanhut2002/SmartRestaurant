<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - KDS Màn Hình Bếp - SmartRestaurant</title>
    <!-- Bootstrap 5.3 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <!-- Custom KDS Styling -->
    <link rel="stylesheet" href="~/css/kds-display.css" asp-append-version="true" />
</head>
<body class="kds-body">
    <!-- KDS Header Bar -->
    <header class="kds-header d-flex justify-content-between align-items-center px-3 py-2">
        <div class="d-flex align-items-center gap-3">
            <span class="kds-logo fw-bold fs-5 text-warning">
                <i class="bi bi-fire me-1"></i> SMART KDS
            </span>
            <span class="badge bg-secondary fs-6 px-3 py-2" id="kds-current-station-badge">
                @(ViewBag.SelectedStation != null ? ((KitchenStation)ViewBag.SelectedStation).Name : "TẤT CẢ TRẠM")
            </span>
            <div class="btn-group btn-group-sm" role="group">
                <a asp-action="Index" asp-route-stationId="@ViewBag.SelectedStationId" class="btn btn-outline-light active" id="btn-view-tickets">
                    <i class="bi bi-card-checklist me-1"></i> Theo Phiếu
                </a>
                <a asp-action="Aggregated" asp-route-stationId="@ViewBag.SelectedStationId" class="btn btn-outline-light" id="btn-view-aggregated">
                    <i class="bi bi-layers-half me-1"></i> Gom Món Nấu
                </a>
                <a asp-action="Expediter" class="btn btn-outline-warning" id="btn-view-expediter">
                    <i class="bi bi-bell-fill me-1"></i> Trạm Điều Phối (Pass)
                </a>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <!-- 86 Item Sold Out Toggle Button -->
            <button class="btn btn-sm btn-outline-danger" onclick="kdsApp.open86Modal()">
                <i class="bi bi-slash-circle me-1"></i> Báo Hết Món (86)
            </button>

            <!-- Sound Alert Toggle -->
            <button class="btn btn-sm btn-outline-info" id="btn-toggle-sound" onclick="kdsApp.toggleSound()">
                <i class="bi bi-volume-up-fill" id="sound-icon"></i> <span id="sound-text">Chuông: BẬT</span>
            </button>

            <!-- Fullscreen Toggle -->
            <button class="btn btn-sm btn-outline-secondary" onclick="kdsApp.toggleFullScreen()">
                <i class="bi bi-fullscreen"></i>
            </button>

            <!-- Clock -->
            <div class="kds-clock text-info fw-bold fs-5 font-monospace" id="kds-clock">
                --:--:--
            </div>
        </div>
    </header>

    <!-- Main Content Grid -->
    <main class="kds-main-container">
        @RenderBody()
    </main>

    <!-- Modal: Báo Làm Lại Món (Remake Dish per OD-09) -->
    <div class="modal fade" id="remakeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-danger text-light">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger">
                        <i class="bi bi-arrow-repeat me-1"></i> Báo Làm Lại Món (Remake - Không Tính Tiền Khách)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="remake-item-id" />
                    <div class="mb-3">
                        <label class="form-label text-secondary">Tên món cần làm lại:</label>
                        <h4 class="text-warning fw-bold" id="remake-item-name">--</h4>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lý do làm lại (bắt buộc):</label>
                        <select class="form-select bg-black text-light border-secondary" id="remake-reason-select">
                            <option value="Cháy / Chín quá / Sống">Cháy / Chín quá / Sống</option>
                            <option value="Nêm nếm mặn / nhạt / sai khẩu vị">Nêm nếm mặn / nhạt / sai khẩu vị</option>
                            <option value="Có dị vật / Lỗi kỹ thuật">Có dị vật / Lỗi kỹ thuật</option>
                            <option value="Món nguội do phục vụ trễ">Món nguội do phục vụ trễ</option>
                            <option value="Khách đổi ý yêu cầu làm lại">Khách đổi ý yêu cầu làm lại</option>
                            <option value="other">Lý do khác...</option>
                        </select>
                    </div>
                    <div class="mb-3 d-none" id="remake-custom-reason-container">
                        <label class="form-label">Chi tiết lý do:</label>
                        <textarea class="form-control bg-black text-light border-secondary" id="remake-custom-reason" rows="2" placeholder="Ghi rõ lý do làm lại..."></textarea>
                    </div>
                    <div class="alert alert-warning py-2 mb-0 small">
                        <i class="bi bi-info-circle me-1"></i> Theo quy định <strong>OD-09</strong>: Khách không bị tính thêm tiền (0đ). Chi phí nguyên liệu sẽ tự động ghi nhận vào sổ hao hụt bếp (KitchenWasteLog).
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy Bỏ</button>
                    <button type="button" class="btn btn-danger" onclick="kdsApp.confirmRemake()">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Xác Nhận Làm Lại Ngay
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal: Quản Lý Báo Hết Món (86 Menu Items per BR-KIT-006) -->
    <div class="modal fade" id="modal86" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark border-warning text-light">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning">
                        <i class="bi bi-slash-circle me-1"></i> Danh Sách Báo Hết Món Nhanh (86 Items)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <input type="text" class="form-control bg-black text-light border-secondary" id="search-86-input" placeholder="Tìm tên món để đổi trạng thái..." onkeyup="kdsApp.filter86Items()" />
                    </div>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Mã Món</th>
                                    <th>Tên Món Ăn</th>
                                    <th>Khu Vực Bếp</th>
                                    <th>Trạng Thái</th>
                                    <th class="text-end">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody id="table-86-body">
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Đang tải danh mục món...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/kds-app.js" asp-append-version="true"></script>
    <script src="~/js/kds-signalr.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
