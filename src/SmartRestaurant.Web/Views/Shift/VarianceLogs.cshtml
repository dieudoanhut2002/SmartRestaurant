@model List<ShiftVarianceLogDto>
@{
    ViewData["Title"] = "Sổ Kiểm Toán Chênh Lệch Két Tiền";
}

<div class="container-fluid p-0">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-journal-text me-2 text-danger"></i>Sổ Kiểm Toán Chênh Lệch Két Tiền (ShiftClosingVarianceLog)</h5>
                <small class="text-muted">Ghi nhận minh bạch mọi sai lệch tiền mặt sau kiểm tiền mù chốt ca theo quyết định OD-14 / INV-12</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay Lại Quản Lý Ca
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Thời Gian Ghi Nhận</th>
                            <th class="text-end">Tiền Quỹ Đầu</th>
                            <th class="text-end">Doanh Số Tiền Mặt</th>
                            <th class="text-end">Dự Kiến Phải Thu</th>
                            <th class="text-end">Tiền Mặt Thực Đếm</th>
                            <th class="text-center">Số Tiền Lệch</th>
                            <th class="pe-3">Giải Trình Của Thu Ngân</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                                    Không có bản ghi lệch két nào. Toàn bộ các ca làm việc đều khớp tiền 100%.
                                </td>
                            </tr>
                        }
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="ps-3 small text-muted font-monospace">@log.LoggedAt.ToString("HH:mm:ss - dd/MM/yyyy")</td>
                                <td class="text-end">@log.OpeningFloat.ToString("N0") ₫</td>
                                <td class="text-end text-primary">@log.SystemRevenue.ToString("N0") ₫</td>
                                <td class="text-end fw-semibold">@log.ExpectedAmount.ToString("N0") ₫</td>
                                <td class="text-end fw-bold">@log.ActualCountedAmount.ToString("N0") ₫</td>
                                <td class="text-center">
                                    @if (log.VarianceAmount == 0)
                                    {
                                        <span class="badge bg-success text-white">Khớp 0 ₫</span>
                                    }
                                    else if (log.VarianceAmount > 0)
                                    {
                                        <span class="badge bg-warning text-dark">+@log.VarianceAmount.ToString("N0") ₫ (Dư)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white">@log.VarianceAmount.ToString("N0") ₫ (Thiếu)</span>
                                    }
                                </td>
                                <td class="pe-3 small text-muted">@(string.IsNullOrEmpty(log.CashierNotes) ? "—" : log.CashierNotes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
