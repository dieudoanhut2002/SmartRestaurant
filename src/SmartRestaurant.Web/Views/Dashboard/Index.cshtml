@model DashboardStatsDto
@{
    ViewData["Title"] = "Bảng Điều Khiển Tổng Quan";
}

<div class="container-fluid p-0">
    <!-- Quick Status Banner -->
    <div class="alert alert-info border-0 shadow-sm d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <i class="bi bi-clock-history fs-4 me-3 text-primary"></i>
            <div>
                <strong>Ca Kinh Doanh Hiện Tại:</strong> Mốc chốt ca mặc định 06:00 sáng. Mọi giao dịch được ghi nhận tự động theo ngày kinh doanh (Business Date).
            </div>
        </div>
        <div>
            <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check-circle me-1"></i>Hệ thống ổn định</span>
        </div>
    </div>

    <!-- Key Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-primary-subtle p-3 text-primary me-3">
                        <i class="bi bi-cash-coin fs-2"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Doanh Thu Hôm Nay</div>
                        <h4 class="mb-0 fw-bold text-dark">@Model.TodayRevenue.ToString("N0") ₫</h4>
                        <small class="text-success"><i class="bi bi-arrow-up-right me-1"></i>Đồng bộ tức thời</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-warning-subtle p-3 text-warning-emphasis me-3">
                        <i class="bi bi-grid-3x3-gap fs-2"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Bàn Đang Có Khách</div>
                        <h4 class="mb-0 fw-bold text-dark">@Model.ActiveTablesCount / @Model.TotalTablesCount <span class="fs-6 text-muted font-monospace">(@Model.TableOccupancyRate%)</span></h4>
                        <small class="text-muted">Tỷ lệ lấp đầy sảnh ăn</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-success-subtle p-3 text-success me-3">
                        <i class="bi bi-person-badge fs-2"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Ca Thu Ngân Đang Mở</div>
                        <h4 class="mb-0 fw-bold text-dark">@Model.OpenShiftsCount Ca</h4>
                        <small class="text-success"><i class="bi bi-shield-lock me-1"></i>Kiểm tiền mù cuối ca</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-danger-subtle p-3 text-danger me-3">
                        <i class="bi bi-exclamation-triangle fs-2"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Cảnh Báo Hết Hàng (86)</div>
                        <h4 class="mb-0 fw-bold text-dark">@Model.LowStockItemCount Món</h4>
                        <small class="text-danger"><i class="bi bi-bell-fill me-1"></i>Cần nhập thêm / Tạm khóa</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts & Tables Row -->
    <div class="row g-4 mb-4">
        <!-- Hourly Revenue Chart -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-graph-up me-2 text-primary"></i>Biểu Đồ Doanh Số Theo Khung Giờ (Hôm Nay)</h6>
                    <span class="badge bg-light text-muted border">Đơn vị: VNĐ</span>
                </div>
                <div class="card-body p-3">
                    <canvas id="revenueChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Quick Table Status Summary -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pie-chart me-2 text-warning"></i>Phân Bổ Trạng Thái Bàn Ăn</h6>
                </div>
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light">
                        <span class="badge bg-success me-2 px-2 py-1"><i class="bi bi-check-lg me-1"></i>Trống (Available)</span>
                        <strong class="text-dark">@(Model.TotalTablesCount - Model.ActiveTablesCount) bàn</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light">
                        <span class="badge bg-warning text-dark me-2 px-2 py-1"><i class="bi bi-person-fill me-1"></i>Có Khách (Occupied)</span>
                        <strong class="text-dark">@Model.ActiveTablesCount bàn</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light">
                        <span class="badge bg-primary me-2 px-2 py-1"><i class="bi bi-calendar-check me-1"></i>Đã Đặt (Reserved)</span>
                        <strong class="text-dark">1 bàn</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light">
                        <span class="badge bg-danger me-2 px-2 py-1"><i class="bi bi-brush me-1"></i>Cần Dọn (Cleaning)</span>
                        <strong class="text-dark">1 bàn</strong>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="FloorPlan" asp-action="Index" class="btn btn-outline-primary w-100 btn-sm">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Mở Sơ Đồ Bàn 2D Chi Tiết
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Selling Dishes & Recent Activities -->
    <div class="row g-4">
        <!-- Top Selling Dishes -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-award-fill me-2 text-warning"></i>Top Món Ăn Bán Chạy Nhất</h6>
                    <a asp-controller="Menu" asp-action="Index" class="small text-primary text-decoration-none">Xem toàn bộ thực đơn</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Mã Món</th>
                                    <th>Tên Món Ăn</th>
                                    <th class="text-center">Số Lượng Bán</th>
                                    <th class="text-end pe-3">Doanh Thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TopSellingDishes)
                                {
                                    <tr>
                                        <td class="ps-3"><span class="badge bg-secondary-subtle text-dark font-monospace">@item.DishCode</span></td>
                                        <td class="fw-semibold">@item.DishName</td>
                                        <td class="text-center"><span class="badge bg-success-subtle text-success">@item.QuantitySold phần</span></td>
                                        <td class="text-end pe-3 fw-bold text-primary">@item.TotalRevenue.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Operational Activity Trail -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-activity me-2 text-danger"></i>Nhật Ký Thao Tác Quản Lý & Bếp</h6>
                    <a asp-controller="Report" asp-action="PinAudits" class="small text-primary text-decoration-none">Nhật ký đầy đủ</a>
                </div>
                <div class="card-body p-3">
                    <div class="list-group list-group-flush">
                        @foreach (var act in Model.RecentActivities)
                        {
                            <div class="list-group-item px-0 py-2 border-0 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge @(act.ActivityType == "PIN Duyệt" ? "bg-warning-subtle text-warning-emphasis" : "bg-danger-subtle text-danger")">
                                        @act.ActivityType
                                    </span>
                                    <small class="text-muted font-monospace">@act.Timestamp.ToString("HH:mm:ss")</small>
                                </div>
                                <div class="small fw-semibold text-dark">@act.Description</div>
                                <small class="text-muted">Người thực hiện: <strong>@act.PerformedBy</strong></small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('revenueChart').getContext('2d');
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HourlyRevenue.Select(h => h.HourLabel)));
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HourlyRevenue.Select(h => h.Revenue)));

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (₫)',
                    data: data,
                    borderColor: '#ffc107',
                    backgroundColor: 'rgba(255, 193, 7, 0.15)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.35,
                    pointRadius: 5,
                    pointBackgroundColor: '#ffc107'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + ' ₫';
                            }
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.raw.toLocaleString('vi-VN') + ' ₫';
                            }
                        }
                    }
                }
            }
        });
    </script>
}
