@using SmartRestaurant.Application.DTOs
@model ExecutiveBiDashboardDto
@{
    ViewData["Title"] = "Executive BI & Hiệu Suất Vận Hành";
    var fromDateStr = ViewBag.FromDate as string ?? Model.FromDate.ToString("yyyy-MM-dd");
    var toDateStr = ViewBag.ToDate as string ?? Model.ToDate.ToString("yyyy-MM-dd");

    // BCG Matrix counts
    var starCount = Model.MenuEngineering.Count(m => m.Classification.Contains("Star"));
    var plowhorseCount = Model.MenuEngineering.Count(m => m.Classification.Contains("Plowhorse"));
    var puzzleCount = Model.MenuEngineering.Count(m => m.Classification.Contains("Puzzle"));
    var dogCount = Model.MenuEngineering.Count(m => m.Classification.Contains("Dog"));

    var estimatedCogs = Math.Max(0, Model.TotalRevenue - Model.TotalGrossProfit);
}

<div class="container-fluid p-0">
    <!-- Filter & Export Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <form method="get" asp-action="Analytics" class="d-flex flex-wrap align-items-center gap-2">
                    <label class="form-label mb-0 fw-semibold text-muted small text-nowrap"><i class="bi bi-calendar-range me-1"></i>Khoảng Ngày:</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@fromDateStr" style="max-width: 150px;" />
                    <span class="text-muted small">&rarr;</span>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@toDateStr" style="max-width: 150px;" />
                    <button type="submit" class="btn btn-primary btn-sm px-3">
                        <i class="bi bi-funnel-fill me-1"></i> Lọc Dữ Liệu
                    </button>
                </form>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="ExportMenuEngineeringCsv" class="btn btn-outline-warning btn-sm text-dark">
                    <i class="bi bi-filetype-csv me-1"></i> Xuất Ma Trận BCG (CSV)
                </a>
                <a asp-action="ExportDailySalesCsv" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel me-1"></i> Xuất Doanh Thu Ngày (CSV)
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Báo Cáo Doanh Thu
                </a>
            </div>
        </div>
    </div>

    <!-- Executive KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <!-- 1. Total Net Revenue -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-white-50 small fw-medium text-uppercase">Doanh Thu Thuần (Net Sales)</span>
                        <span class="badge bg-white text-primary fw-bold"><i class="bi bi-currency-dollar me-1"></i>Doanh Số</span>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.TotalRevenue.ToString("N0") ₫</h3>
                    <div class="d-flex justify-content-between text-white-50 small">
                        <span>@Model.TotalOrders lượt đơn hàng</span>
                        <span>TB: @Model.AverageTicketSize.ToString("N0") ₫/bàn</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Gross Margin & BOM COGS -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-white-50 small fw-medium text-uppercase">Lợi Nhuận Gộp (Gross Margin)</span>
                        <span class="badge bg-white text-success fw-bold">Biên LN @Model.OverallMarginPercent.ToString("F1")%</span>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.TotalGrossProfit.ToString("N0") ₫</h3>
                    <div class="d-flex justify-content-between text-white-50 small">
                        <span>Giá vốn COGS: @estimatedCogs.ToString("N0") ₫</span>
                        <span>Định mức 35%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. KDS Kitchen SLA Performance -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-white-50 small fw-medium text-uppercase">Tuân Thủ SLA Bếp (KDS)</span>
                        <span class="badge bg-white text-info fw-bold">@Model.SlaPerformance.SlaCompliancePercent.ToString("F1")%</span>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.SlaPerformance.AverageElapsedMinutes.ToString("F1") <small class="fs-6 fw-normal">phút/món</small></h3>
                    <div class="d-flex justify-content-between text-white-50 small">
                        <span>Nhanh (&lt;10m): @Model.SlaPerformance.FastUnder10MinCount</span>
                        <span>Trễ (&gt;20m): @Model.SlaPerformance.Overdue20MinCount</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Table Turnover & Guests -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 bg-warning text-dark">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-dark-50 small fw-bold text-uppercase">Hiệu Suất Khai Thác Bàn</span>
                        <span class="badge bg-dark text-white fw-bold">@Model.TopTables.Count bàn theo dõi</span>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.AverageTableDurationMinutes.ToString("F0") <small class="fs-6 fw-normal">phút/bàn</small></h3>
                    <div class="d-flex justify-content-between text-muted small">
                        <span>Lưu bàn TB: @Model.AverageTableDurationMinutes.ToString("F0") phút</span>
                        <span>Lượt quay: @(Model.TopTables.Any() ? Model.TopTables.Average(t => t.TurnsCount).ToString("F1") : "0") lượt</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1: Hourly Heatmap & Payment Breakdown -->
    <div class="row g-4 mb-4">
        <!-- Chart 1: Hourly Sales & Order Traffic Peak Load Heatmap -->
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Biểu Đồ Nhiệt Khung Giờ Hoạt Động (00:00 - 23:00)</h6>
                        <small class="text-muted">Doanh thu và số lượng đơn hàng theo từng khung giờ trong ngày</small>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Peak Load Analysis</span>
                </div>
                <div class="card-body p-3">
                    <div style="height: 320px; position: relative;">
                        <canvas id="hourlySalesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 2: Payment Tender Channels Doughnut -->
        <div class="col-12 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pie-chart me-2 text-success"></i>Cơ Cấu Phương Thức Thanh Toán</h6>
                        <small class="text-muted">Tỷ trọng tiền mặt, VietQR 24/7 và quẹt thẻ</small>
                    </div>
                </div>
                <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                    <div style="height: 230px; width: 100%; position: relative;">
                        <canvas id="paymentMethodChart"></canvas>
                    </div>
                    <div class="w-100 mt-3 pt-2 border-top">
                        <div class="d-flex justify-content-between small mb-1">
                            <span><i class="bi bi-circle-fill text-info me-1"></i>VietQR 24/7:</span>
                            <strong class="text-dark">@Model.VietQrRevenue.ToString("N0") ₫</strong>
                        </div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span><i class="bi bi-circle-fill text-success me-1"></i>Tiền mặt (Cash):</span>
                            <strong class="text-dark">@Model.CashRevenue.ToString("N0") ₫</strong>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span><i class="bi bi-circle-fill text-warning me-1"></i>Quẹt thẻ (Card):</span>
                            <strong class="text-dark">@Model.CardRevenue.ToString("N0") ₫</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2: Category Breakdown & KDS SLA Distribution -->
    <div class="row g-4 mb-4">
        <!-- Category Sales Share -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-tag-fill me-2 text-warning"></i>Doanh Số Theo Nhóm Thực Đơn</h6>
                    <small class="text-muted">Cơ cấu doanh thu phát sinh theo nhóm món ẩm thực</small>
                </div>
                <div class="card-body p-3">
                    <div style="height: 250px; position: relative;">
                        <canvas id="categorySalesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- KDS Kitchen Ticket SLA Distribution -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-stopwatch-fill me-2 text-danger"></i>Thời Gian Trả Món KDS Bếp & Bar</h6>
                    <small class="text-muted">Phân bố thời gian hoàn tất chế biến món ăn</small>
                </div>
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div class="row g-2 text-center mb-3">
                        <div class="col-4">
                            <div class="p-2 border rounded bg-success-subtle text-success">
                                <div class="fs-4 fw-bold">@Model.SlaPerformance.FastUnder10MinCount</div>
                                <div class="small fw-semibold">&lt; 10 phút (SLA Đạt)</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded bg-warning-subtle text-warning-emphasis">
                                <div class="fs-4 fw-bold">@Model.SlaPerformance.Medium10To20MinCount</div>
                                <div class="small fw-semibold">10 - 20 phút (Cảnh Báo)</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded bg-danger-subtle text-danger">
                                <div class="fs-4 fw-bold">@Model.SlaPerformance.Overdue20MinCount</div>
                                <div class="small fw-semibold">&gt; 20 phút (Trễ Hạn)</div>
                            </div>
                        </div>
                    </div>
                    <div class="p-3 bg-light rounded border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-dark">Tỷ Lệ Đạt Chuẩn SLA (&lt; 10 phút):</span>
                            <span class="badge bg-success">@Model.SlaPerformance.SlaCompliancePercent.ToString("F1")%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @Model.SlaPerformance.SlaCompliancePercent%;" aria-valuenow="@Model.SlaPerformance.SlaCompliancePercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted mt-2 d-block">
                            Tổng số ticket chế biến: <strong>@Model.SlaPerformance.TotalTickets</strong> vé bếp. Thời gian hoàn tất trung bình: <strong>@Model.SlaPerformance.AverageElapsedMinutes.ToString("F1") phút/vé</strong>.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Menu Engineering BCG Matrix -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 pt-3 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-grid-3x3-gap-fill me-2 text-primary"></i>Phân Tích Thực Đơn & Ma Trận BCG (Menu Engineering Matrix)</h6>
                <small class="text-muted">Đánh giá hiệu quả kinh doanh từng món theo Số lượng tiêu thụ và Biên lợi nhuận gộp BOM</small>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-star-fill text-warning me-1"></i>Ngôi Sao (@starCount)</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-speedometer2 me-1"></i>Ngựa Thồ (@plowhorseCount)</span>
                <span class="badge bg-warning-subtle text-dark border border-warning-subtle"><i class="bi bi-question-circle me-1"></i>Câu Đố (@puzzleCount)</span>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i>Chó Cưng (@dogCount)</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã Món</th>
                            <th>Tên Món Ăn</th>
                            <th>Danh Mục</th>
                            <th class="text-end">Giá Bán</th>
                            <th class="text-end">Giá Vốn BOM (35%)</th>
                            <th class="text-end">Lãi Gộp / Món</th>
                            <th class="text-center">Biên LN (%)</th>
                            <th class="text-center">Số Lượng</th>
                            <th class="text-end">Tổng Lãi Gộp</th>
                            <th class="text-center pe-3">Phân Nhóm BCG</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.MenuEngineering.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                    Chưa có dữ liệu phân tích thực đơn trong khoảng thời gian này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.MenuEngineering)
                            {
                                <tr>
                                    <td class="ps-3"><span class="badge bg-secondary-subtle text-dark font-monospace">@item.DishCode</span></td>
                                    <td class="fw-semibold">@item.DishName</td>
                                    <td><span class="badge bg-light text-muted border">@item.CategoryName</span></td>
                                    <td class="text-end fw-semibold">@item.SellingPrice.ToString("N0") ₫</td>
                                    <td class="text-end text-muted small">@item.EstimatedCost.ToString("N0") ₫</td>
                                    <td class="text-end fw-bold text-success">@item.GrossMarginAmount.ToString("N0") ₫</td>
                                    <td class="text-center">
                                        <span class="badge @(item.MarginPercent >= 65 ? "bg-success" : "bg-secondary")">
                                            @item.MarginPercent.ToString("F1")%
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold">@item.QuantitySold</td>
                                    <td class="text-end fw-bold text-primary">@item.TotalProfit.ToString("N0") ₫</td>
                                    <td class="text-center pe-3">
                                        <span class="badge @item.BadgeClass">
                                            @if (item.Classification.Contains("Star"))
                                            {
                                                <i class="bi bi-star-fill text-warning me-1"></i><span>@item.Classification</span>
                                            }
                                            else if (item.Classification.Contains("Plowhorse"))
                                            {
                                                <i class="bi bi-speedometer2 me-1"></i><span>@item.Classification</span>
                                            }
                                            else if (item.Classification.Contains("Puzzle"))
                                            {
                                                <i class="bi bi-question-circle me-1"></i><span>@item.Classification</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle me-1"></i><span>@item.Classification</span>
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-light p-3">
            <div class="row g-2 small text-muted">
                <div class="col-12 col-md-3"><strong>🌟 Ngôi Sao (Star):</strong> Sản lượng cao, Lãi cao. Giữ vị trí vàng trên menu và chuẩn hóa chất lượng nguyên liệu.</div>
                <div class="col-12 col-md-3"><strong>🐎 Ngựa Thồ (Plowhorse):</strong> Sản lượng cao, Lãi thấp. Tăng giá nhẹ hoặc tối ưu định lượng BOM nguyên liệu.</div>
                <div class="col-12 col-md-3"><strong>🧩 Câu Đố (Puzzle):</strong> Sản lượng thấp, Lãi cao. Đẩy mạnh upsell, giới thiệu tại bàn hoặc giảm giá khuyến mãi kích cầu.</div>
                <div class="col-12 col-md-3"><strong>🐶 Chó Cưng (Dog):</strong> Sản lượng thấp, Lãi thấp. Cân nhắc loại bỏ khỏi thực đơn để giảm tồn kho nguyên liệu.</div>
            </div>
        </div>
    </div>

    <!-- Section 4: Table Turnover & Utilization Rate -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
            <div>
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-arrow-repeat me-2 text-info"></i>Hiệu Suất Sử Dụng & Lượt Quay Vòng Bàn (Table Turnover Rate)</h6>
                <small class="text-muted">Đo lường năng suất khai thác mặt bằng phòng ăn</small>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã Bàn</th>
                            <th>Tên Bàn</th>
                            <th>Khu Vực / Tầng</th>
                            <th class="text-center">Số Lượt Đón Khách (Turns)</th>
                            <th class="text-center">Thời Gian Lưu Bàn TB (phút)</th>
                            <th class="text-end pe-3">Tổng Doanh Thu Tạo Ra</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TopTables.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu sử dụng bàn.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var table in Model.TopTables)
                            {
                                <tr>
                                    <td class="ps-3"><span class="badge bg-light text-dark font-monospace border">@table.TableCode</span></td>
                                    <td class="fw-semibold">@table.TableName</td>
                                    <td><span class="badge bg-secondary-subtle text-dark">@table.AreaName</span></td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">
                                            @table.TurnsCount lượt
                                        </span>
                                    </td>
                                    <td class="text-center text-muted">@table.AverageDurationMinutes.ToString("F0") phút</td>
                                    <td class="text-end pe-3 fw-bold text-success">@table.TotalRevenueGenerated.ToString("N0") ₫</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Hourly Sales & Orders Bar/Line Combo Chart
            const hourlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HourlyHeatmap.Select(h => h.HourLabel)));
            const hourlyRevenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HourlyHeatmap.Select(h => h.Revenue)));
            const hourlyOrderData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HourlyHeatmap.Select(h => h.OrderCount)));

            const ctxHourly = document.getElementById('hourlySalesChart');
            if (ctxHourly) {
                new Chart(ctxHourly, {
                    type: 'bar',
                    data: {
                        labels: hourlyLabels,
                        datasets: [
                            {
                                label: 'Doanh Thu (₫)',
                                data: hourlyRevenueData,
                                backgroundColor: 'rgba(13, 110, 253, 0.75)',
                                borderColor: 'rgb(13, 110, 253)',
                                borderWidth: 1,
                                yAxisID: 'yRevenue',
                                borderRadius: 4
                            },
                            {
                                label: 'Số Lượt Đơn',
                                data: hourlyOrderData,
                                type: 'line',
                                borderColor: '#ffc107',
                                backgroundColor: '#ffc107',
                                borderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                tension: 0.3,
                                yAxisID: 'yOrders'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        scales: {
                            yRevenue: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                ticks: {
                                    callback: function(value) {
                                        return (value / 1000000).toFixed(1) + ' tr';
                                    }
                                },
                                title: {
                                    display: true,
                                    text: 'Doanh Thu (VNĐ)'
                                }
                            },
                            yOrders: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                grid: {
                                    drawOnChartArea: false
                                },
                                title: {
                                    display: true,
                                    text: 'Lượt Đơn Dùng Bữa'
                                }
                            }
                        }
                    }
                });
            }

            // 2. Payment Method Channels Doughnut Chart
            const ctxPayment = document.getElementById('paymentMethodChart');
            if (ctxPayment) {
                new Chart(ctxPayment, {
                    type: 'doughnut',
                    data: {
                        labels: ['VietQR 24/7', 'Tiền Mặt', 'Thẻ POS'],
                        datasets: [{
                            data: [
                                @Model.VietQrRevenue,
                                @Model.CashRevenue,
                                @Model.CardRevenue
                            ],
                            backgroundColor: ['#0dcaf0', '#198754', '#ffc107'],
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            }

            // 3. Category Sales Share Chart
            const categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown.Select(c => c.CategoryName)));
            const categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown.Select(c => c.Revenue)));

            const ctxCategory = document.getElementById('categorySalesChart');
            if (ctxCategory && categoryLabels.length > 0) {
                new Chart(ctxCategory, {
                    type: 'bar',
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            label: 'Doanh Thu (₫)',
                            data: categoryData,
                            backgroundColor: [
                                'rgba(13, 110, 253, 0.7)',
                                'rgba(25, 135, 84, 0.7)',
                                'rgba(255, 193, 7, 0.7)',
                                'rgba(13, 202, 240, 0.7)',
                                'rgba(108, 117, 125, 0.7)',
                                'rgba(220, 53, 69, 0.7)'
                            ],
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: {
                                ticks: {
                                    callback: function(value) {
                                        return (value / 1000).toLocaleString('vi-VN') + 'k';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
