@model DailySalesReportDto
@{
    ViewData["Title"] = "Báo Cáo Doanh Thu & Kiểm Toán";
    var topDishes = ViewBag.TopDishes as List<TopSellingDishDto> ?? [];
    var selectedDate = ViewBag.SelectedDate as string;
}

<div class="container-fluid p-0">
    <!-- Top Action Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 fw-semibold text-muted small text-nowrap">Ngày Kinh Doanh (06:00 Cutoff):</label>
                    <input type="date" name="businessDate" class="form-control form-control-sm" value="@selectedDate" onchange="this.form.submit()" />
                </form>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="WasteLogs" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash3-fill me-1"></i> Sổ Hao Phí Nhà Bếp (WasteLog)
                </a>
                <a asp-action="PinAudits" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-shield-check me-1"></i> Nhật Ký PIN Quản Lý (AuditLog)
                </a>
            </div>
        </div>
    </div>

    <!-- Revenue Breakdown Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body p-3">
                    <div class="text-white-50 small fw-medium">Tổng Doanh Thu Ngày</div>
                    <h3 class="mb-0 fw-bold">@Model.TotalRevenue.ToString("N0") ₫</h3>
                    <small class="text-white-50">@Model.TotalOrders lượt đơn dùng bữa</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-medium">Tiền Mặt (Cash)</span>
                        <span class="badge bg-success-subtle text-success">40%</span>
                    </div>
                    <h4 class="mb-0 fw-bold text-dark">@Model.CashRevenue.ToString("N0") ₫</h4>
                    <small class="text-muted">Đã đối soát két thu ngân</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-medium">Chuyển Khoản (VietQR 24/7)</span>
                        <span class="badge bg-info-subtle text-info-emphasis">45%</span>
                    </div>
                    <h4 class="mb-0 fw-bold text-dark">@Model.VietQrRevenue.ToString("N0") ₫</h4>
                    <small class="text-muted">Khớp webhook Napas tự động</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-medium">Quẹt Thẻ (POS Terminal)</span>
                        <span class="badge bg-secondary-subtle text-dark">15%</span>
                    </div>
                    <h4 class="mb-0 fw-bold text-dark">@Model.CardRevenue.ToString("N0") ₫</h4>
                    <small class="text-muted">Đơn TB: @Model.AverageTicketSize.ToString("N0") ₫ / bill</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Sales Breakdown & Top Selling Items -->
    <div class="row g-4">
        <!-- Category Sales Breakdown -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Tỷ Trọng Doanh Thu Theo Nhóm Món</h6>
                </div>
                <div class="card-body p-3">
                    @foreach (var cat in Model.CategoryBreakdown)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold text-dark">@cat.CategoryName</span>
                                <span class="small text-muted">@cat.Revenue.ToString("N0") ₫ (@cat.Percentage.ToString("F1")%)</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-warning" role="progressbar" style="width: @cat.Percentage%;" aria-valuenow="@cat.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Top Selling Items Detailed Table -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-3 px-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-trophy-fill me-2 text-warning"></i>Bảng Thống Kê Món Ăn Bán Chạy Nhất</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Mã Món</th>
                                    <th>Tên Món Ăn</th>
                                    <th>Danh Mục</th>
                                    <th class="text-center">Số Lượng Bán</th>
                                    <th class="text-end pe-3">Doanh Số</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dish in topDishes)
                                {
                                    <tr>
                                        <td class="ps-3"><span class="badge bg-secondary-subtle text-dark font-monospace">@dish.DishCode</span></td>
                                        <td class="fw-semibold">@dish.DishName</td>
                                        <td><span class="badge bg-light text-muted border">@dish.CategoryName</span></td>
                                        <td class="text-center fw-bold text-success">@dish.QuantitySold</td>
                                        <td class="text-end pe-3 fw-bold text-primary">@dish.TotalRevenue.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
