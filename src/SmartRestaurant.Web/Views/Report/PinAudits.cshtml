@model List<ManagerPinAuditLogDto>
@{
    ViewData["Title"] = "Nhật Ký Kiểm Toán Mã PIN Quản Lý";
}

<div class="container-fluid p-0">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-check me-2 text-warning-emphasis"></i>Nhật Ký Kiểm Toán Mã PIN Quản Lý (ManagerPinAuditLog)</h5>
                <small class="text-muted">Bất biến kiểm toán INV-09 / BR-SEC-003: Mọi thao tác cần duyệt quyền (hủy món nấu, chiết khấu, mở két) đều lưu vết tức thì</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Báo Cáo Doanh Thu
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Thời Gian Thao Tác</th>
                            <th>Quản Lý Duyệt</th>
                            <th>Hành Động / Nghiệp Vụ</th>
                            <th>Đối Tượng / Bàn / Đơn</th>
                            <th class="pe-3">Lý Do Ủy Quyền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-shield-shaded fs-1 d-block mb-2 text-secondary"></i>
                                    Chưa có sự kiện duyệt mã PIN nào được ghi nhận.
                                </td>
                            </tr>
                        }
                        @foreach (var audit in Model)
                        {
                            <tr>
                                <td class="ps-3 small text-muted font-monospace">@audit.Timestamp.ToString("HH:mm:ss - dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge bg-warning-subtle text-warning-emphasis fw-bold">
                                        <i class="bi bi-person-check-fill me-1"></i>@audit.ManagerName
                                    </span>
                                </td>
                                <td class="fw-semibold text-dark">@audit.ActionName</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@audit.TargetEntity</span>
                                </td>
                                <td class="pe-3 text-muted small">@audit.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
