@model List<StaffMemberDto>
@{
    ViewData["Title"] = "Nhân Viên & Phân Quyền (RBAC)";
}

<div class="container-fluid p-0">
    <!-- Top Action Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-people-fill me-2 text-primary"></i>Danh Sách Nhân Sự & Tài Khoản</h5>
                <small class="text-muted">Quản lý phân quyền 6 vai trò tiêu chuẩn & Đăng nhập nhanh bằng PIN 4 chữ số (BR-SEC-001/002)</small>
            </div>
            <button type="button" class="btn btn-warning fw-semibold btn-sm" data-bs-toggle="modal" data-bs-target="#createStaffModal">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm Nhân Viên Mới
            </button>
        </div>
    </div>

    <!-- Staff Table -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Họ và Tên</th>
                            <th>Tên Đăng Nhập</th>
                            <th>Email Liên Hệ</th>
                            <th>Vai Trò (RBAC)</th>
                            <th class="text-center">Mã PIN 4 Số</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-end pe-3">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var staff in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-secondary-subtle text-secondary fw-bold rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                            @staff.FullName.Substring(0, 1)
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@staff.FullName</div>
                                            <small class="text-muted">ID: @staff.Id.ToString().Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@staff.Username</span>
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrEmpty(staff.Email) ? "—" : staff.Email)
                                </td>
                                <td>
                                    @switch (staff.Role)
                                    {
                                        case StaffRole.SystemAdmin:
                                            <span class="badge bg-dark text-white"><i class="bi bi-shield-lock-fill me-1"></i>Quản Trị Hệ Thống</span>
                                            break;
                                        case StaffRole.RestaurantManager:
                                            <span class="badge bg-primary text-white"><i class="bi bi-star-fill me-1"></i>Quản Lý Nhà Hàng</span>
                                            break;
                                        case StaffRole.Cashier:
                                            <span class="badge bg-success text-white"><i class="bi bi-cash-stack me-1"></i>Thu Ngân</span>
                                            break;
                                        case StaffRole.Waiter:
                                            <span class="badge bg-info text-dark"><i class="bi bi-person-walking me-1"></i>Bồi Bàn / Phục Vụ</span>
                                            break;
                                        case StaffRole.Chef:
                                            <span class="badge bg-danger text-white"><i class="bi bi-fire me-1"></i>Đầu Bếp / Bếp Trưởng</span>
                                            break;
                                        case StaffRole.InventoryStaff:
                                            <span class="badge bg-warning text-dark"><i class="bi bi-box-seam-fill me-1"></i>Thủ Kho</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary-subtle text-dark font-monospace">••••</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-primary text-decoration-none"
                                            onclick="openResetPinModal('@staff.Id', '@staff.FullName')">
                                        Đổi PIN
                                    </button>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(staff.IsActive ? "bg-success-subtle text-success" : "bg-secondary text-white")">
                                        @(staff.IsActive ? "Đang hoạt động" : "Đã khóa")
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group">
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@staff.Id" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Khóa / Mở khóa">
                                                <i class="bi @(staff.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Manager PIN Authorization Demo Card -->
    <div class="card border-0 shadow-sm bg-warning-subtle">
        <div class="card-body p-4">
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check me-2 text-warning-emphasis"></i>Thử Nghiệm Cơ Chế Ủy Quyền Bằng PIN Quản Lý (BR-SEC-003 / INV-09)</h6>
            <p class="small text-muted mb-3">
                Trong vận hành F&B, các thao tác nhạy cảm như hủy món đã nấu, chiết khấu lớn hay mở két tiền đều yêu cầu xác thực PIN của Quản Lý. Hệ thống sẽ tự động ghi sổ nhật ký kiểm toán (ManagerPinAuditLog).
            </p>
            <div class="row g-2 align-items-center" style="max-width: 600px;">
                <div class="col-6">
                    <input type="password" id="test-pin-input" class="form-control text-center font-monospace fs-5" placeholder="Nhập PIN Quản lý (mặc định 1234)" maxlength="4" />
                </div>
                <div class="col-6">
                    <button type="button" class="btn btn-dark w-100 fw-semibold" onclick="testManagerPinAuth()">
                        <i class="bi bi-key-fill me-1"></i> Xác Thực Thao Tác
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Create Staff -->
<div class="modal fade" id="createStaffModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <input type="hidden" name="BranchId" value="@ViewBag.BranchId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2 text-warning"></i>Thêm Nhân Viên Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và Tên <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control" placeholder="Ví dụ: Hoàng Văn Nam" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Tên Đăng Nhập <span class="text-danger">*</span></label>
                            <input type="text" name="Username" class="form-control" placeholder="nam.hv" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Mã PIN Đăng Nhập (4 số) <span class="text-danger">*</span></label>
                            <input type="password" name="PinCode" class="form-control text-center font-monospace" placeholder="1234" maxlength="4" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Liên Hệ</label>
                        <input type="email" name="Email" class="form-control" placeholder="nam.hv@smartrestaurant.vn" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai Trò Phân Quyền (RBAC) <span class="text-danger">*</span></label>
                        <select name="Role" class="form-select" required>
                            <option value="4">Phục Vụ / Bồi Bàn (Waiter)</option>
                            <option value="3">Thu Ngân (Cashier)</option>
                            <option value="5">Đầu Bếp / Bếp Trưởng (Chef)</option>
                            <option value="2">Quản Lý Nhà Hàng (Restaurant Manager)</option>
                            <option value="6">Thủ Kho (Inventory Staff)</option>
                            <option value="1">Quản Trị Hệ Thống (System Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warning fw-semibold">Tạo Tài Khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reset PIN -->
<div class="modal fade" id="resetPinModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form asp-action="ResetPin" method="post">
                <input type="hidden" name="StaffId" id="reset-staff-id" />
                <div class="modal-header">
                    <h6 class="modal-title fw-bold" id="reset-staff-title">Đặt Lại Mã PIN</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small">Nhập mã PIN 4 chữ số mới:</label>
                    <input type="password" name="NewPinCode" class="form-control text-center fs-3 font-monospace" maxlength="4" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openResetPinModal(id, name) {
            document.getElementById('reset-staff-id').value = id;
            document.getElementById('reset-staff-title').textContent = `Đổi PIN: ${name}`;
            new bootstrap.Modal(document.getElementById('resetPinModal')).show();
        }

        async function testManagerPinAuth() {
            const pin = document.getElementById('test-pin-input').value;
            if (!pin || pin.length !== 4) {
                Swal.fire('Thông báo', 'Vui lòng nhập đủ 4 chữ số PIN', 'warning');
                return;
            }

            const response = await fetch('/Staff/AuthorizeManagerPin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    pinCode: pin,
                    actionName: 'Duyệt Chiết Khấu Thử Nghiệm',
                    targetEntity: 'Bàn SV-01 / Thử nghiệm cổng quản lý',
                    reason: 'Kiểm tra cơ chế phê duyệt PIN của Quản Lý'
                })
            });

            const result = await response.json();
            if (result.isAuthorized) {
                Swal.fire({
                    icon: 'success',
                    title: 'Ủy Quyền Thành Công!',
                    text: 'Mã PIN Quản lý chính xác. Hệ thống đã ghi nhận nhật ký kiểm toán vào ManagerPinAuditLog.',
                    timer: 2500
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Ủy Quyền Bị Từ Chối',
                    text: 'Mã PIN không đúng hoặc nhân viên này không có quyền Quản lý/Admin.'
                });
            }
        }
    </script>
}
