<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Cổng Quản Lý SmartRestaurant</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <!-- Custom Admin Styles -->
    <link rel="stylesheet" href="~/css/admin.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <aside class="sidebar bg-dark text-white p-3 shadow-sm" id="sidebar-wrapper">
            <div class="sidebar-heading pb-3 mb-3 border-bottom border-secondary d-flex align-items-center">
                <i class="bi bi-shop fs-3 text-warning me-2"></i>
                <div>
                    <h5 class="mb-0 text-white fw-bold">SmartRestaurant</h5>
                    <small class="text-secondary">Cổng Quản Lý & Vận Hành</small>
                </div>
            </div>
            <nav class="nav nav-pills flex-column gap-1">
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active bg-warning text-dark fw-bold" : "")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill me-2"></i> Tổng Quan
                </a>
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "FloorPlan" ? "active bg-warning text-dark fw-bold" : "")" asp-controller="FloorPlan" asp-action="Index">
                    <i class="bi bi-map-fill me-2"></i> Sơ Đồ Bàn 2D
                </a>
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active bg-warning text-dark fw-bold" : "")" asp-controller="Menu" asp-action="Index">
                    <i class="bi bi-cup-hot-fill me-2"></i> Thực Đơn & Món
                </a>
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Station" ? "active bg-warning text-dark fw-bold" : "")" asp-controller="Station" asp-action="Index">
                    <i class="bi bi-fire me-2"></i> Trạm Chế Biến
                </a>
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active bg-warning text-dark fw-bold" : "")" asp-controller="Inventory" asp-action="Index">
                    <i class="bi bi-boxes me-2"></i> Quản Lý Kho
                </a>
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" ? "active bg-warning text-dark fw-bold" : "")" asp-controller="Staff" asp-action="Index">
                    <i class="bi bi-people-fill me-2"></i> Nhân Viên & PIN
                </a>
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shift" ? "active bg-warning text-dark fw-bold" : "")" asp-controller="Shift" asp-action="Index">
                    <i class="bi bi-cash-stack me-2"></i> Ca & Kiểm Tiền Mù
                </a>
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active bg-warning text-dark fw-bold" : "")" asp-controller="Report" asp-action="Index">
                    <i class="bi bi-bar-chart-line-fill me-2"></i> Báo Cáo & Sổ Hao Phí
                </a>
                <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Setting" ? "active bg-warning text-dark fw-bold" : "")" asp-controller="Setting" asp-action="Index">
                    <i class="bi bi-gear-fill me-2"></i> Cấu Hình Vận Hành
                </a>
            </nav>

            <div class="mt-auto pt-4 border-top border-secondary text-secondary small">
                <div class="d-flex align-items-center mb-2">
                    <div class="status-indicator bg-success me-2 rounded-circle" style="width: 10px; height: 10px;"></div>
                    <span class="text-light">Chi Nhánh 1 (Trung Tâm)</span>
                </div>
                <div>Giờ cắt ca: <strong class="text-warning">06:00 sáng</strong></div>
                <div>Phiên bản: <strong class="text-light">v1.0.0-FROZEN</strong></div>
            </div>
        </aside>

        <!-- Page Content Wrapper -->
        <div id="page-content-wrapper" class="w-100 d-flex flex-column min-vh-100">
            <!-- Top Navbar -->
            <header class="navbar navbar-expand-lg navbar-white bg-white border-bottom px-4 py-2 sticky-top shadow-sm">
                <div class="container-fluid p-0">
                    <button class="btn btn-outline-secondary d-md-none me-3" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-2 px-2 py-1">
                            <i class="bi bi-geo-alt-fill me-1"></i> Sàn Vận Hành
                        </span>
                        <h5 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h5>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <div class="text-end d-none d-sm-block">
                            <div class="fw-bold text-dark">Trần Thị Bình</div>
                            <small class="text-muted"><i class="bi bi-shield-check text-success me-1"></i>Quản Lý Nhà Hàng</small>
                        </div>
                        <div class="avatar bg-warning text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                            QL
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Body -->
            <main class="flex-grow-1 p-4">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-top py-3 px-4 text-center text-muted small mt-auto">
                <div class="container-fluid d-flex flex-column flex-sm-row justify-content-between align-items-center">
                    <div>SmartRestaurant &copy; 2026 — Nền tảng điều hành nhà hàng thông minh chuyên biệt Việt Nam.</div>
                    <div>100% Giao diện chuẩn tiếng Việt bản địa (Vietnamese-First).</div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom Admin JS -->
    <script src="~/js/admin.js"></script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành Công!',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                timer: 3000,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Thông Báo Lỗi',
                text: '@Html.Raw(TempData["ErrorMessage"])'
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
