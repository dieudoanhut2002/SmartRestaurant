<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thu Ngân & Quyết Toán - SmartRestaurant</title>
    <!-- Bootstrap 5.3 & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <!-- Custom Cashier Styling -->
    <link rel="stylesheet" href="~/css/cashier.css" asp-append-version="true" />
</head>
<body class="cashier-body">
    <!-- Cashier Top Navigation Bar -->
    <header class="cashier-navbar navbar navbar-expand-lg navbar-dark bg-dark px-3 py-2 border-bottom border-primary shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-warning d-flex align-items-center gap-2" asp-controller="Cashier" asp-action="Index">
                <i class="bi bi-calculator-fill fs-4"></i> SMART CASHIER
            </a>

            <div class="d-flex align-items-center gap-3">
                <ul class="navbar-nav d-flex flex-row gap-2">
                    <li class="nav-item">
                        <a class="nav-link btn btn-sm btn-outline-light px-3 py-1 text-white" asp-controller="Cashier" asp-action="Index">
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i> Bàn Cần Thanh Toán
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn btn-sm btn-outline-warning px-3 py-1 text-warning" asp-controller="Cashier" asp-action="Shift">
                            <i class="bi bi-wallet2 me-1"></i> Quản Lý Ca & Giao Tiền
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn btn-sm btn-outline-info px-3 py-1 text-info" asp-controller="Cashier" asp-action="Suspense">
                            <i class="bi bi-clock-history me-1"></i> Tiền Treo (Suspense)
                        </a>
                    </li>
                </ul>

                <div class="vr bg-secondary d-none d-md-block" style="height: 25px;"></div>

                <!-- Clock -->
                <div class="text-info font-monospace fw-bold" id="cashier-clock">--:--:--</div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="cashier-main-container">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/cashier-app.js" asp-append-version="true"></script>
    <script src="~/js/cashier-signalr.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
