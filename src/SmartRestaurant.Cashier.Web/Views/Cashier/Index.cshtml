@model IReadOnlyList<CashierBillSummaryDto>
@{
    ViewData["Title"] = "Bàn Chờ Thanh Toán";
    var activeShift = (WorkShift?)ViewBag.ActiveShift;
}

<div class="container-fluid p-4">
    <!-- Shift Status Banner -->
    <div class="card mb-4 border-0 shadow-sm bg-light">
        <div class="card-body d-flex justify-content-between align-items-center py-2 px-3">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary fs-6 p-2">
                    <i class="bi bi-person-badge me-1"></i> Thu Ngân Đang Trực
                </span>
                @if (activeShift != null)
                {
                    <span class="text-success fw-bold">
                        <i class="bi bi-check-circle-fill me-1"></i> Ca làm việc đang mở
                    </span>
                    <span class="text-muted small">Quỹ đầu ca: <strong>@activeShift.OpeningCashFloat.ToString("N0") ₫</strong></span>
                    <span class="text-muted small">Tiền mặt thu trong ca: <strong class="text-primary">@activeShift.SystemCashTotal.ToString("N0") ₫</strong></span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Chưa mở ca thu ngân
                    </span>
                    <a asp-action="Shift" class="btn btn-sm btn-outline-primary">Mở Ca Ngay</a>
                }
            </div>
            <div>
                <span class="badge bg-danger rounded-pill fs-6 px-3 py-2">
                    @Model.Count Bàn Chờ Thanh Toán
                </span>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center p-5 text-muted bg-white rounded shadow-sm">
            <i class="bi bi-check-circle fs-1 text-success mb-2"></i>
            <h4>Không có bàn nào đang yêu cầu thanh toán</h4>
            <p>Khi nhân viên hoặc khách yêu cầu thanh toán trên POS Tablet, bàn sẽ xuất hiện tại đây ngay lập tức.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var bill in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-2 border-warning cashier-table-card">
                        <div class="card-header bg-warning bg-opacity-25 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fs-4 fw-bold text-dark">@bill.TableCode</span>
                                <span class="badge bg-secondary ms-1">@bill.AreaName</span>
                            </div>
                            <span class="badge bg-danger animate-pulse">
                                <i class="bi bi-bell-fill me-1"></i> Yêu Cầu Thanh Toán
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted">Giờ vào bàn:</span>
                                <span class="fw-bold">@bill.StartedAt.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted">Số lượng món:</span>
                                <span class="fw-bold">@bill.Items.Sum(i => i.Quantity) món</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted">Tiền hàng (chưa VAT):</span>
                                <span>@bill.Subtotal.ToString("N0") ₫</span>
                            </div>
                            @if (bill.SurchargeAmount > 0)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 text-info">
                                    <span>Phụ thu phòng VIP (@bill.SurchargeRate%):</span>
                                    <span>+@bill.SurchargeAmount.ToString("N0") ₫</span>
                                </div>
                            }
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fs-5 fw-bold text-dark">Tổng Tiền (Gồm VAT):</span>
                                <span class="fs-4 fw-bold text-danger">@bill.TotalAmount.ToString("N0") ₫</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white d-flex gap-2">
                            <a asp-action="Bill" asp-route-id="@bill.OrderId" class="btn btn-primary flex-grow-1 fw-bold py-2">
                                <i class="bi bi-cash-stack me-1"></i> Quyết Toán Ngay
                            </a>
                            <a asp-action="Split" asp-route-id="@bill.OrderId" class="btn btn-outline-secondary py-2" title="Tách hóa đơn">
                                <i class="bi bi-scissors me-1"></i> Tách Bill
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
